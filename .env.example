# AWS RDS connection
SPRING_DATASOURCE_URL=
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_SA_PASSWORD=

KAFKA_BOOTSTRAP_SERVERS=

# Shared secret for internal gRPC calls (metadata x-internal-api-key)
APP_INTERNAL_API_KEY=

# Internal gRPC server (iam.v1 contract consumed by ms-forgot-information and
# usermanagement.v1 contract consumed by ms-fleet)
GRPC_SERVER_PORT=5001
GRPC_SERVER_ENABLED=true

# JWT RS256
JWT_ISSUER=
JWT_AUDIENCE=
JWT_KEY_ID=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
