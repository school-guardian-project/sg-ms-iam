MSSQL_DATABASE=database
MSSQL_USER=user
MSSQL_SA_PASSWORD=password

KAFKA_BOOTSTRAP_SERVERS={nombre del servicio}:{puerto kafka}
# Shared secret sent by ms-forgot-information in X-Internal-Api-Key (generate with: openssl rand -base64 32)
INTERNAL_API_KEY=REPLACE_ME

# Default country code used to strip it from E.164 phone lookups (Person.Phone stores national digits only)
PHONE_DEFAULT_COUNTRY_CODE=57
