spring.datasource.url=jdbc:sqlserver://sqlserver:1433;databaseName=${MSSQL_DATABASE};encrypt=false;trustServerCertificate=true
spring.datasource.username=${MSSQL_USER}
spring.datasource.password=${MSSQL_SA_PASSWORD}

spring.jpa.properties.hibernate.default_schema=Iam

spring.jpa.hibernate.naming.physical-strategy=org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl

# Real client IP behind Caddy -> Kong (see application.properties).
server.forward-headers-strategy=native
server.tomcat.remoteip.remote-ip-header=x-forwarded-for
server.tomcat.remoteip.protocol-header=x-forwarded-proto
server.tomcat.remoteip.internal-proxies=10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|172\\.(1[6-9]|2[0-9]|3[0-1])\\.\\d{1,3}\\.\\d{1,3}|192\\.168\\.\\d{1,3}\\.\\d{1,3}|127\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|0:0:0:0:0:0:0:1|::1

# Token lifetimes (FR-2.2 / HU-IAM-001): access token 1 hour, refresh token 7 days.
# The login and refresh use cases and the issued JWTs all read these same keys.
app.jwt.access-token-expiration-minutes=60
app.jwt.refresh-token-expiration-days=7